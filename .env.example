NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (managed PaaS or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestion_notes

# JWT secrets (must be at least 32 characters in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Typst CLI binary path
TYPST_BIN=typst

# Initial bootstrap admin (used by db:seed / optional auto-seed)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=AdminLycee2026!
ADMIN_INITIAL_FULLNAME=Administrateur Principal
CORS_ORIGIN=http://localhost:5173
